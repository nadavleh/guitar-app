# core.autocrlf=true on the dev machine, so without this the POSIX wrapper script
# gets committed/checked out with CRLF and its `#!/bin/sh` shebang breaks on Linux CI.
# Shell scripts and YAML must stay LF regardless of platform.
*.sh    text eol=lf
gradlew text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
